# ZecOne — environment template (demo deployment). Copy to .env and fill in.
# Never commit real values. Live payouts / Zcash broadcast cannot be enabled
# through any of these variables in this build.

# ---------- Payment API (npm run payments:start) ----------
ZECONE_PAYMENTS_HOST=127.0.0.1
ZECONE_PAYMENTS_PORT=4321
ZECONE_PAYMENTS_DB=.state/payments.sqlite
ZECONE_PAYMENTS_MODE=demo                 # demo | monitor ("live" is refused at startup)
# ---- monitor mode only (real receiving address, read-only mainnet watcher, NO payout) ----
# ZECONE_MONITOR_AUTHORIZED=I_UNDERSTAND_NO_AUTOMATIC_PAYOUT
# ZECONE_WATCH_WORKER_CONFIG=/path/to/mainnet-watch-worker.json  # same file scripts/mainnet-watch-worker.ts uses
# ZECONE_WATCH_BIN=                       # optional path to zecone-zcash-watch(.exe)
# ZECONE_WATCH_INTERVAL_SECONDS=120
# ZECONE_WATCH_MAX_AGE_SECONDS=900        # real checkouts pause if the last verified snapshot is older
ZECONE_PUBLIC_URL=http://localhost:3000   # where /pay/:id is served (ZecOne web app)
# Hosts allowed to request merchant wallet signatures (EIP-4361 domain), comma separated
ZECONE_SIWE_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:4333,127.0.0.1:4333
ZECONE_BASE_RPC_URL=                      # optional: enables ERC-1271/6492 smart-wallet signatures
# ZECONE_CHECKOUT_ADDRESS=                # monitor mode only; never set for the public demo
ZECONE_EXCLUSIVE_ALLOCATION=1             # single active checkout per address (keep 1)
ZECONE_QUOTE_TTL_SECONDS=900
ZECONE_MAX_AMOUNT_USD=500.00
ZECONE_RELAYER_AVAILABLE_WEI=50000000000000000   # operator snapshot for the liquidity guard
ZECONE_DEMO_SECRET=change-me-at-least-32-random-characters
ZECONE_DEMO_PAYOUT_ADDRESS=0x1111111111111111111111111111111111111111 # labelled demo identity; no payout occurs
ZECONE_DEMO_OBSERVER=1                    # server-side replay of recorded mainnet evidence
ZECONE_DEMO_OBSERVER_DELAY=12
ZECONE_DEMO_OBSERVER_STEP=2
ZECONE_OPERATOR_TOKEN=                    # empty disables loopback operator endpoints
ZECONE_ALLOW_HTTP_WEBHOOKS=1              # set 0 in any shared deployment (https only)
ZECONE_SESSION_TTL_SECONDS=28800
ZECONE_TRUST_PROXY=0                      # set 1 only when the API is reachable solely through the private reverse proxy

# ---------- ZecOne web app (npm run build:web && npm run start:web) ----------
ZECONE_BASE_URL=http://127.0.0.1:4321     # payment API origin, server-side only
# ZECONE_API_KEY=                         # optional override of the demo storefront key

# ---------- Access Pass example (npm run dapp:start) ----------
ACCESS_PASS_PORT=4333
ACCESS_PASS_PUBLIC_URL=http://127.0.0.1:4333
ACCESS_PASS_BACKEND_URL=http://127.0.0.1:4333 # separate HTTPS VPS backend URL when the frontend is on Vercel
ACCESS_PASS_STATE=.state/access-pass.json # holds its API key + webhook secret (mode 600)
ZECONE_WEB_URL=http://localhost:3000
