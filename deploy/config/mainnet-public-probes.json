{
  "zcash": {
    "lightwalletd": [
      { "endpoint": "https://zec.rocks:443", "operator": "zec.rocks" },
      { "endpoint": "https://us.zec.stardust.rest:443", "operator": "stardust" }
    ],
    "headerRpc": {
      "endpoint": "https://zcash-mainnet-zebrad.gateway.tatum.io",
      "operator": "tatum"
    },
    "rawBlocks": [
      {
        "endpoint": "https://zcash-mainnet-zebrad.gateway.tatum.io",
        "operator": "tatum",
        "protocol": "zcash-json-rpc",
        "authHeader": "x-api-key",
        "authEnv": "ZECONE_TATUM_API_KEY"
      },
      {
        "endpoint": "https://shared.eu-central-1.getblock.io",
        "operator": "getblock",
        "protocol": "zcash-json-rpc",
        "endpointEnv": "ZECONE_GETBLOCK_URL"
      }
    ]
  },
  "base": [
    { "endpoint": "https://mainnet.base.org", "operator": "coinbase" },
    { "endpoint": "https://base-rpc.publicnode.com", "operator": "allnodes" }
  ],
  "solana": [
    {
      "endpoint": "https://api.mainnet-beta.solana.com",
      "operator": "solana-foundation"
    },
    { "endpoint": "https://solana-rpc.publicnode.com", "operator": "allnodes" }
  ]
}
