# Compose interpolation only. Copy to deploy/demo/.env on the VPS.
ZECONE_WEB_DOMAIN=demo.example.com
ZECONE_API_DOMAIN=api.demo.example.com
ACCESS_PASS_DOMAIN=access.example.com
ACCESS_PASS_API_DOMAIN=access-api.demo.example.com
ACME_EMAIL=operator@example.com
# Absolute path on the VPS, chmod 600; generated by scripts/generate-demo-deployment-env.ts.
ZECONE_DEMO_ENV_FILE=/opt/zecone-demo/secrets/demo.env
