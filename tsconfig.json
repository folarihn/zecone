{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "services/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "marketplace/**/*.ts"
  ]
}
