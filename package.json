{
  "name": "zecone-phase0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "wallets": "tsx scripts/wallets.ts",
    "cli": "tsx services/execution/cli.ts",
    "user": "tsx scripts/user.ts",
    "contracts:test": "forge test",
    "wallet:dev": "tsx services/wallet/server.ts --dev",
    "wallet:build": "node scripts/build-wallet.mjs",
    "wallet:start": "tsx services/wallet/server.ts",
    "wallet:open": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/launch-wallet.ps1",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test:ui": "playwright test",
    "test:extension": "playwright test -c playwright.extension.config.ts",
    "dapp:fixture": "node test-dapp/server.mjs",
    "phase2:deploy-action": "tsx scripts/actions.ts deploy --allow-testnet-broadcast",
    "phase2:live-dapp": "tsx scripts/live-phase2-dapp.ts --allow-testnet-transaction",
    "phase2:pair-browser": "tsx scripts/pair-phase2-browser.ts",
    "phase2:live-sponsor": "tsx scripts/live-phase2-sponsor.ts --allow-testnet-spend",
    "phase2:sponsor-status": "tsx scripts/phase2-sponsor-status.ts",
    "phase2:readiness": "tsx scripts/phase2-readiness.ts",
    "phase2:verify-live": "tsx scripts/verify-phase2-live.ts",
    "marketplace:dev": "tsx marketplace/server.ts",
    "phase3:setup": "tsx scripts/phase3-setup.ts --allow-testnet-broadcast",
    "phase3:status": "tsx scripts/phase3-status.ts",
    "phase3:verify-live": "tsx scripts/verify-phase3-live.ts",
    "phase3:pair-browser": "tsx scripts/pair-phase3-browser.ts",
    "phase4a:setup": "tsx scripts/phase4a-setup.ts",
    "phase4a:preflight": "tsx scripts/phase4a-preflight.ts",
    "lint": "node scripts/phase6-lint.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@uniswap/v2-core": "1.0.1",
    "@uniswap/v2-periphery": "1.1.0-beta.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "postcss": "8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "seaport-types": "1.6.3",
    "tailwindcss": "4.3.3",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
